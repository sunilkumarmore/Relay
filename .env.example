# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Provider address. Set this to pin a worker to one provider and bypass the
# market entirely — this is what the two-machine demo does. Leave it empty and
# the worker discovers providers from the directory instead.
# On Machine 1 (inference node): http://localhost:8765
# On Machine 2 (worker node): http://<machine1-ip>:8765
INFERENCE_REGISTRY=http://localhost:8765

# How a consumer chooses between providers that meet the job's requirements:
# cheapest (default) | fastest | round_robin | pinned
# RELAY_POLICY=cheapest
# Pin to one provider by node id (implies RELAY_POLICY=pinned)
# RELAY_PINNED_NODE=
# Seconds a provider stays benched after failing us (default 120)
# RELAY_FAILOVER_COOLDOWN=120
# Attempts per provider before failing over (default 3)
# RELAY_MAX_RETRIES=3

# Inference registry port (Machine 1 only, default 8765)
# REGISTRY_PORT=8765

# Ollama - only needed on Machine 1
# Must bind to 0.0.0.0 for network access
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
# Generation timeout in seconds (default 180; increase for large models)
# OLLAMA_TIMEOUT=180

# Worker identity - change per worker instance
WORKER_ID=worker-alpha

# Session ID (optional) - auto-generated as a UUID if left blank.
# Set this explicitly to resume a previous session.
# SESSION_ID=

# Machine identity
MACHINE_ID=my-machine

# Node role - controls what this machine runs
# inference (Machine 1) or worker (Machine 2)
NODE_ROLE=worker

# Task file (optional) - path to a YAML file defining your task steps.
# If omitted, the built-in demo math problems are used.
# See tasks/example.yaml for the format.
# TASK_FILE=tasks/example.yaml

# Max tokens per LLM response (default 1200)
# MAX_TOKENS=1200

# Seconds to sleep between steps (default 5, set to 0 to disable)
# STEP_SLEEP_SECONDS=5

# Optional: choose a custom env file for each worker instance
# Linux/Mac:   ENV_FILE=.env.alpha python worker/daemon.py
# Windows:     set ENV_FILE=.env.alpha && python worker/daemon.py
ENV_FILE=.env

# --- Test / development overrides -------------------------------------------
# Where Relay keeps state. "supabase" (default) is the real thing; "memory" and
# "file" exist so the test suite can run with no network.
# RELAY_STORE=supabase
# RELAY_STORE_PATH=/tmp/relay-store.json   # required when RELAY_STORE=file

# Which inference backend the registry serves. "ollama" (default) or "fake"
# (deterministic, no LLM required — used by the tests).
# RELAY_BACKEND=ollama
# RELAY_FAKE_LATENCY_MS=0
# RELAY_FAKE_FAIL_CALLS=

# Where worker reports are written (default: ./output)
# RELAY_OUTPUT_DIR=output

# --- Credits ----------------------------------------------------------------
# Relay has no payment rail: credits are an internal unit. Set this to 1 to
# enable the development faucet:
#   python -m relay.controller wallet deposit --amount 100 --dev
# RELAY_DEV_MODE=0

# Where this node's Ed25519 identity lives. The hex public key is the node id,
# and it is what receipts and offers are signed with — back this file up.
# RELAY_KEY_PATH=~/.relay/node.key

# --- Reputation, stake and verification -------------------------------------
# Skip providers whose record is worse than this. Scores run 0-1; a node with no
# history sits at the prior and is NOT excluded by a modest floor — being new is
# not the same as being bad.
# RELAY_MIN_REPUTATION=0.4

# Ignore providers with less than this staked. Stake is what a slash draws from:
# a provider with nothing at risk has nothing to lose.
# RELAY_MIN_STAKE=0

# Fraction of steps to send to a second provider and compare (0-1). Costs twice
# as much on sampled steps, and feeds reputation rather than triggering payment.
# RELAY_VERIFY_SAMPLE_RATE=0

# --- Agent ------------------------------------------------------------------
# Steps now share one conversation, and each sees what came before. Context is
# finite, so older turns are folded into a summary when the next prompt would
# not fit. The window comes from the provider's offer; this is the fallback for
# a pinned endpoint with no offer behind it.
# RELAY_CONTEXT_WINDOW=8192

# Turns always kept verbatim at the end of the history when compacting.
# RELAY_KEEP_RECENT=4

# Run independent steps concurrently. Leave at 1 for a plain linear agent: a
# parallel wave sees the history as of the START of the wave, not as of each
# other, so raising this can change the answers as well as the speed.
# RELAY_MAX_PARALLEL=1

# --- Database access under row-level security -------------------------------
# With migrations 002 and 008 applied, the anon key reaches nothing on its own:
# every policy is written against a relay_node_id claim that only the token
# authority can mint. Nodes exchange a signature for a short-lived token.
#
# On a node (worker, provider, controller, dashboard):
# RELAY_AUTHORITY_URL=http://<authority-host>:8790
# RELAY_TOKEN_REFRESH_SKEW=120

# On the authority, and NOWHERE ELSE. This is the Supabase project's JWT secret
# (Settings > API > JWT Settings). A node that has it can mint a token for any
# identity, which is the whole reason it lives in one place.
# RELAY_JWT_SECRET=
# RELAY_AUTHORITY_PORT=8790
# RELAY_TOKEN_TTL=3600

# Leave RELAY_AUTHORITY_URL unset to connect with SUPABASE_KEY directly. That is
# how Relay worked before RLS, and it still works if you have not applied 002.

# ============================================================================
# DISTRIBUTED TASKS — renting out a device that has no GPU and no model
# ============================================================================
# A task node runs work between an agent's thinking steps: multiplying a block
# of a matrix, transforming text, reducing numbers. It needs no model and no
# GPU, which is what makes a phone or an old laptop a plausible provider.
#
# There is no server here and no port to open. A node polls Supabase over
# HTTPS, takes a lease on a task, does it, and posts a signed result. Nothing
# ever connects *to* your device, so carrier NAT and home routers are not in
# the way.
#
# The minimum a provider needs is SUPABASE_URL, SUPABASE_KEY and this file.
# Then:  python -m relay.tasks node

# Which kinds of work this machine will accept. Comma-separated.
# Default (leave unset): matmul_block,text_transform,data_reduce — all pure
# arithmetic on data carried inside the task. No filesystem, no network, no
# code supplied by anybody else.
# RELAY_TASK_TYPES=matmul_block,text_transform,data_reduce

# python_exec runs code written by whoever signed the task. It is NOT in the
# default list and you have to add it deliberately. It runs in a subprocess
# under CPU, memory and file-size limits, which stops a task exhausting the
# machine — it does NOT stop the code reading files your user account can read.
# It is not a security sandbox. Enable it only for consumers you trust, and
# name them in RELAY_ALLOWED_CONSUMERS when you do.
# RELAY_TASK_TYPES=matmul_block,python_exec

# Node ids (hex public keys) this machine will work for. Empty means anyone,
# which is the marketplace default — a market where you must know your
# customers in advance is not one.
# RELAY_ALLOWED_CONSUMERS=

# How many tasks at once. One is right for a laptop you are also using.
# RELAY_MAX_CONCURRENT_TASKS=1

# Longest single task this machine will accept, in seconds. A task asking for
# more is refused at claim time rather than started and abandoned.
# RELAY_MAX_TASK_SECONDS=300

# Ceiling on how much data one task may carry, in bytes. Matters on a phone.
# RELAY_MAX_PAYLOAD_BYTES=67108864

# Memory ceiling for python_exec, in MB.
# RELAY_MAX_TASK_MEMORY_MB=512

# Stop taking new work but finish what is in hand. Set this instead of killing
# the process if you want your laptop back without losing the fee for a task
# you have nearly finished.
# RELAY_PAUSED=false

# How long a lease lasts. A device that stops renewing loses its lease and its
# work goes back to the queue — this is the ONLY failure detection there is,
# and it is why a phone dropping off a network costs one block rather than the
# job. Must exceed RELAY_MAX_TASK_SECONDS by at least 120s or the node refuses
# to start, because a lease that expires mid-task gets the work done twice and
# billed twice.
# RELAY_LEASE_SECONDS=900

# Seconds between polls when there is nothing to do.
# RELAY_POLL_INTERVAL=5

# Where this node's Ed25519 key lives. The public key IS the node id. Delete
# it and you are a different node with no reputation and no balance.
# RELAY_KEY_FILE=~/.relay/node.key

# --- Running without Supabase ------------------------------------------------
# Every device sharing one directory on one machine, for trying it out:
# RELAY_STORE=file
# RELAY_STORE_PATH=/tmp/relay-tasks.json

# --- Only for local multi-process testing ------------------------------------
# Margin between a task's deadline and its lease expiring, covering clock skew
# between the device and the database plus the round trip carrying the result.
# Lower it only when both are known to be negligible — several processes on one
# machine. Any real deployment leaves it alone.
# RELAY_LEASE_SLACK_SECONDS=120
