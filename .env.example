# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Inference node address
# On Machine 1 (inference node): http://localhost:8765
# On Machine 2 (worker node): http://<machine1-ip>:8765
INFERENCE_REGISTRY=http://localhost:8765

# Ollama - only needed on Machine 1
# Must bind to 0.0.0.0 for network access
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Worker identity - change per worker instance
# worker-alpha for first instance, worker-beta for second
WORKER_ID=worker-alpha

# Session - generate unique UUID per worker
# python -c "import uuid; print(uuid.uuid4())"
SESSION_ID=your-session-uuid-here

# Machine identity
# on Machine 1: WINDOWS-INF
# on Machine 2: WINDOWS-WORKER
MACHINE_ID=WINDOWS-WORKER

# Node role - controls what this machine runs
# on Machine 1: inference
# on Machine 2: worker
NODE_ROLE=worker

# Optional: choose custom env file for worker instances
# set ENV_FILE=.env.alpha (or .env.beta)
ENV_FILE=.env
